<%
  if (typeof el === 'undefined') {
    var el = '';
  }

  if (typeof attr === 'undefined') {
    var attr = '';
  }
%>

<header class="header">
  <<%= el %> class="<%= attr %>">
    <a class="header__link" href="/">
      <img class="header__logo" src="<%= path %>images/common/logo.svg" alt="GRASS FIELD">
    </a>
  </<%= el %>>

  <button class="header__gNavBten gNavBtn" type="button" aria-label="メニューを開く" aria-controls="gNav" aria-expanded="false">
    <span class="gNavBtn__line" aria-hidden="true"></span>
  </button>

  <nav class="header__gNav gNav" id="gNav" aria-label="メインメニュー">
    <ul class="gNav__list">
      <li class="gNav__item">
        <a class="gNav__link gNav__link--home" href="/" aria-current="page">Home</a>
      </li>

      <li class="gNav__item">
        <a class="gNav__link gNav__link--service" href="/service">事業内容</a>
      </li>

      <li class="gNav__item">
        <a class="gNav__link gNav__link--products" href="/products">商品紹介</a>
      </li>

      <li class="gNav__item">
        <a class="gNav__link gNav__link--company" href="/company/">会社概要</a>
      </li>

      <li class="gNav__item">
        <a class="gNav__link gNav__link--recruit" href="/recruit/">採用情報</a>
      </li>

      <li class="gNav__item">
        <a class="gNav__link gNav__link--contact" href="/contact">お問合わせ</a>
      </li>
    </ul>
  </nav>
</header>
