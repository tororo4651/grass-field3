<%
  if (typeof pageTitle === 'undefined') {
    var pageTitle = '';
  }

  if (typeof description === 'undefined') {
    var description = '';
  }

  if (typeof data === 'undefined') {
    var data = {
      head: '',
      body: ''
    };
  }
%>

<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>
  <% if (pageTitle) { %>
    <%= pageTitle %> | GRASS FIELD
  <% } else { %>
    GRASS FIELD
  <% } %>
</title>

<meta name="description" content="<%= description %>">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@100..900&family=Oswald:wght@500&display=swap" rel="stylesheet">

<link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.15.4/css/all.css" integrity="sha384-DyZ88mC6Up2uqS4h/KRgHuoeGwBcD4Ng9SiP4dIRy0EXTlnuz47vAwmeGwVChigm" crossorigin="anonymous">

<link rel="stylesheet" href="<%= path %>scss/style.scss">

<script type="module" src="<%= path %>js/main.js"></script>
</head>
